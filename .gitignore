# Secrets
.env

# Host fragments that init.sh links from hosts/<hostname>/fish/conf.d/
fish/conf.d/zz-*.fish

# Local agent scratch data
.ai-artifacts/
**/.ai-artifacts/
.agent-runs/
**/.agent-runs/
**/.loop-data/

# macOS metadata
.DS_Store
**/.DS_Store

# Fish rewrites its universal variables here at every set -U, so the file is
# machine state, not configuration. It stays on disk and out of the tree.
fish/fish_variables
