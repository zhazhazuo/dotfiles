<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps scripts/golden-ratio.lua running, so the pane that takes the focus grows
  to about 61.8% of its window.

  The script acts on session_view_changed and does nothing when the focused pane
  has not changed, so a job that is down only means panes keep whatever ratios
  they were given.

  PATH must hold the rex CLI from the server bundle, because launchd does not
  inherit a login shell's PATH.

  Turn on, turn off, or read the state:  golden-ratio on|off|status
  Load, or reload every daemon:          ~/dotfiles/rex/launchd/install.sh
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.rex-golden-ratio</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>exec rex do "$HOME/dotfiles/rex/scripts/golden-ratio.lua" --all</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/walkerw/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/walkerw</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/Users/walkerw/Library/Logs/rex-golden-ratio.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/walkerw/Library/Logs/rex-golden-ratio.log</string>
</dict>
</plist>
