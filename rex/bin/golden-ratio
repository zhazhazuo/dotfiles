#!/usr/bin/env bash
#
# golden-ratio — turn the golden ratio pane resize on or off.
#
# The resize runs as the launchd job local.rex-golden-ratio, kept alive by
# scripts/golden-ratio.lua. Turning it off unloads that job and marks it disabled,
# so it does not start again at login. Turning it on clears the mark and loads it.
#
#   golden-ratio on        load the job, or restart it on the current script
#   golden-ratio off       unload the job and keep it from starting at login
#   golden-ratio status    say whether the resize runs now and after a login
#
# A job that is loaded and disabled runs until the next logout, and a job that is
# unloaded and not disabled starts again at the next login. status names both.
set -euo pipefail

label="local.rex-golden-ratio"
domain="gui/$(id -u)"
agent="$HOME/Library/LaunchAgents/$label.plist"

loaded() { launchctl print "$domain/$label" >/dev/null 2>&1; }

disabled() {
	local listed
	listed=$(launchctl print-disabled "$domain" 2>/dev/null || true)
	# launchd prints the mark as `"<label>" => disabled`, and prints nothing at all
	# for a label it has no mark on.
	printf '%s\n' "$listed" | grep -Eq "\"$label\" => (disabled|true)"
}

usage() {
	printf 'usage: golden-ratio [on|off|status]\n' >&2
	exit 2
}

case "${1:-status}" in
on)
	launchctl enable "$domain/$label"
	if loaded; then
		launchctl kickstart -k "$domain/$label"
		printf 'golden-ratio: on (restarted)\n'
	else
		# The plist is read from LaunchAgents, because a job loaded straight from
		# the dotfiles folder lives only until the next logout.
		if [[ ! -f "$agent" ]]; then
			ln -sf "$(cd -- "$(dirname -- "$0")/.." && pwd)/launchd/$label.plist" "$agent"
		fi
		launchctl bootstrap "$domain" "$agent"
		printf 'golden-ratio: on\n'
	fi
	;;
off)
	launchctl disable "$domain/$label"
	if loaded; then
		launchctl bootout "$domain/$label"
		printf 'golden-ratio: off (unloaded)\n'
	else
		printf 'golden-ratio: off\n'
	fi
	;;
status)
	now=off
	after_login=off
	loaded && now=on
	disabled || after_login=on
	printf 'golden-ratio: %s\n' "$now"
	if [[ "$now" != "$after_login" ]]; then
		if [[ "$now" == on ]]; then
			printf '  it stays off after the next login\n'
		else
			printf '  it starts again after the next login; run: golden-ratio off\n'
		fi
	fi
	;;
*)
	usage
	;;
esac
