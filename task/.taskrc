# [Created by task 3.4.2 6/5/2026 22:10:58]
data.location=$HOME/Research/Brain/Artifact/.task
news.version=3.5.0

uda.estimate.type=numeric
uda.estimate.label=Estimate
uda.estimate.default=1
uda.estimate.values=0.5,1,1.5,2,2.5,3

# Pointers to where a task lives — see ~/.agents/skills/tasks/references/task-pointers.md
# Every pointer must be declared here. An undeclared uda.* does not error: the value is
# silently written into the description instead, destroying it.
uda.repo.type=string
uda.repo.label=Repo
uda.branch.type=string
uda.branch.label=Branch
uda.doc.type=string
uda.doc.label=Doc
uda.ticket.type=string
uda.ticket.label=Ticket

# To use the default location of the XDG directories,
# move this configuration file from ~/.taskrc to ~/.config/task/taskrc and update location config as follows:

#data.location=~/.local/share/task
#hooks.location=~/.config/task/hooks

# _forcecolor=1

color=on

# Column order: `project` and `description` sit next to each other, with `due` after both.
report.next.columns=id,start.age,entry.age,depends,priority,project,description,tags,recur,scheduled.countdown,due.relative,until.remaining,urgency
report.next.labels=ID,Active,Age,Deps,P,Project,Description,Tag,Recur,S,Due,Until,Urg
# next answers "today or tomorrow, or already in flight" — not every pending task.
# The date terms are calendar-aligned: due.before:tomorrow covers overdue AND today;
# `due.before:2d` is a different thing (a rolling 48-hour window).
report.next.filter=+PENDING -WAITING (+ACTIVE or due.before:tomorrow or due:tomorrow or scheduled.before:tomorrow or scheduled:tomorrow) limit:page
report.list.columns=id,start.age,entry.age,depends.indicator,priority,project,description.count,tags,recur.indicator,scheduled.countdown,due,until.remaining,urgency
report.list.labels=ID,Active,Age,D,P,Project,Description,Tags,R,Sch,Due,Until,Urg

# backlog keeps the undated rest in sight, because `next` no longer shows it.
report.backlog.description=Pending tasks with no due and no scheduled date
report.backlog.columns=id,entry.age,priority,project,description,tags,urgency
report.backlog.labels=ID,Age,P,Project,Description,Tag,Urg
report.backlog.filter=+PENDING -WAITING -ACTIVE due.none: scheduled.none: limit:page
report.backlog.sort=urgency-

# Color theme
# include $HOME/dotfiles/task/themes/dark-256.theme

# report.list.columns=id,project,description,tags,priority,estimate,start,due
# report.list.labels=ID,Project,Description,Tags,Pri,Est,StartAt,Due
