+/**
+ * The blocked report the terminal shows while the questionnaire waits. Pi raises one only
+ * for a component that declares it, so without this a waiting question leaves pi
+ * `working`, and a terminal that renders program status shows the run as busy.
+ */
+function blockedOnQuestion(config: { typed: QuestionParams }): {
+	kind: "question";
+	message: string;
+} {
+	const first = config.typed.questions.find((question) => question.question.trim());
+	return { kind: "question", message: (first?.question ?? "Waiting for an answer").trim() };
+}
 
